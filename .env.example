# ==========================================
# Lingo Bridge — Environment Configuration
# ==========================================

# App URL (used for payment callbacks, Telegram deep links, webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (shared-ready with Telegram Bot)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lingobridge?schema=public"

# Authentication (generate a strong 32+ char random string for production)
JWT_SECRET="replace-with-a-strong-64-char-random-secret-key-for-lingo-bridge"

# File Storage ("local" for dev, "s3" for AWS S3 / Cloudflare R2)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"

# S3 / Cloudflare R2 Configuration (used when STORAGE_DRIVER="s3")
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Payment — Manual Card Transfer Settings
PAYMENT_CARD_NUMBER="8600 0000 0000 0000"
PAYMENT_CARD_HOLDER="LINGO BRIDGE MCHJ"
PAYMENT_CARD_BANK="Uzcard / Humo"

# Payment — Online Gateways (Modular)
PAYMENT_MOCK_ENABLED="true"

# Click.uz Integration
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""

# Payme Integration
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="true"

# ==========================================
# Telegram Bot Integration
# ==========================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="lingobridge_bot"
# Comma-separated numeric Telegram chat IDs for admins who receive order/receipt notifications
TELEGRAM_ADMIN_CHAT_IDS=""
# Secret token sent in X-Telegram-Bot-Api-Secret-Token header for webhook verification
TELEGRAM_WEBHOOK_SECRET="lingobridge-telegram-webhook-secret"

# Support Contacts (displayed on Landing & FAQ)
NEXT_PUBLIC_SUPPORT_PHONE="+998 90 123 45 67"
NEXT_PUBLIC_SUPPORT_TELEGRAM="https://t.me/lingobridge_admin"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="lingobridge_bot"
